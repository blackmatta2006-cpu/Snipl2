    function updateFaultVisualization(targetMeters, panToFault = true) {
      const route = getActiveRoute();
      const res = locateFaultAlongRoute(route, targetMeters);
      currentFaultDistanceMeters = res.clampedMeters;

      const slider = document.getElementById('otdrSlider');
      slider.max = res.maxRouteMeters;
      slider.value = res.clampedMeters;
      document.getElementById('sliderValueBadge').textContent = `${res.clampedMeters} m`;
      const hubBadge = document.getElementById('hubUserFaultBadge');
      if (hubBadge) hubBadge.textContent = `${res.clampedMeters} m`;

      document.getElementById('routeSummaryStats').textContent =
        `Ground: ${res.totalGroundMeters}m | Optical (with Slack): ${res.totalOpticalMeters}m`;

      if (intactPolyline) map.removeLayer(intactPolyline);
      if (brokenPolyline) map.removeLayer(brokenPolyline);
      nodeMarkers.forEach((m) => map.removeLayer(m));
      nodeMarkers = [];
      if (faultMarker) map.removeLayer(faultMarker);

      intactPolyline = L.polyline(res.intactLatLngs, {
        color: '#10b981',
        weight: 6,
        opacity: 0.95
      }).addTo(map);

      brokenPolyline = L.polyline(res.brokenLatLngs, {
        color: '#ef4444',
        weight: 5,
        dashArray: '8, 8',
        opacity: 0.8
      }).addTo(map);

      res.analysis.orderedPoints.forEach((pt, idx) => {
        const segInfo = res.analysis.segments[idx];
        const distAtNode = res.slackMode === 'optical' ? Math.round(segInfo.cumOpticalEnd) : Math.round(segInfo.cumGroundEnd);
        const color = pt.type === 'OLT' ? '#06b6d4' : pt.type === 'END' ? '#a855f7' : pt.type === 'JC' ? '#f59e0b' : '#94a3b8';

        const circle = L.circleMarker([pt.lat, pt.lng], {
          radius: pt.type === 'POLE' ? 6 : 8,
          fillColor: color,
          color: '#0f172a',
          weight: 2,
          fillOpacity: 1
        }).addTo(map);

        const nodeMapsUrl = `https://www.google.com/maps?q=${pt.lat},${pt.lng}`;
        const nodeSvUrl = buildStreetViewUrl(pt.lat, pt.lng, res.heading);
        circle.bindPopup(`
          <div class="text-xs space-y-1">
            <div class="font-bold text-emerald-300">${pt.label}</div>
            <div>Distance: <strong>${distAtNode} m</strong> | Loop Slack: <strong>${pt.slack || 0} m</strong></div>
            <div class="font-mono text-[11px] text-slate-300">${pt.lat}, ${pt.lng}</div>
            <div class="flex items-center gap-2 pt-1">
              <a href="${nodeMapsUrl}" target="_blank" rel="noopener noreferrer" class="text-cyan-400 underline">📍 Google Maps ↗</a>
              <a href="${nodeSvUrl}" target="_blank" rel="noopener noreferrer" class="text-amber-400 underline font-semibold">🧍‍♂️ 360° Street View ↗</a>
            </div>
          </div>
        `);
        nodeMarkers.push(circle);
      });

      const faultIcon = L.divIcon({
        className: '',
        html: '<div class="fault-pulse"></div>',
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      });

      const mapsLink = `https://www.google.com/maps?q=${res.lat},${res.lng}`;
      const streetViewLink = buildStreetViewUrl(res.lat, res.lng, res.heading);
      lastFaultResult = res;
      faultMarker = L.marker([res.lat, res.lng], { icon: faultIcon }).addTo(map);
      faultMarker.bindPopup(`
        <div class="text-xs space-y-1.5 p-0.5">
          <div class="font-bold text-red-400 uppercase tracking-wide">⚠️ CABLE CUT @ ${res.clampedMeters}m</div>
          <div class="text-slate-100 font-medium">${res.refLandmark.label} ಹತ್ತಿರ (${res.metersFromLandmark}m ಅಂತರದಲ್ಲಿ)</div>
          <div class="font-mono text-[11px] text-slate-300">GPS: ${res.lat}, ${res.lng} (${res.heading}° ${res.compassDir})</div>
          <div class="grid grid-cols-2 gap-1.5 pt-1">
            <a href="${mapsLink}" target="_blank" rel="noopener noreferrer" class="text-center bg-emerald-600 text-white font-semibold py-1 px-2 rounded">
              📍 Google Maps
            </a>
            <a href="${streetViewLink}" target="_blank" rel="noopener noreferrer" class="text-center bg-amber-500 text-slate-950 font-bold py-1 px-2 rounded">
              🧍‍♂️ Street View
            </a>
          </div>
        </div>
      `);

      if (panToFault) {
        map.setView([res.lat, res.lng], 15, { animate: true });
        faultMarker.openPopup();
      }

      document.getElementById('faultDistanceBadge').textContent = `${res.clampedMeters} m (${(res.clampedMeters / 1000).toFixed(2)} km)`;
      document.getElementById('faultNearestLandmark').textContent = res.insideLoopClosure
        ? `${res.refLandmark.label} (Joint Box ಒಳಗೆ ಕಟ್ ಆಗಿದೆ)`
        : `${res.refLandmark.label} ಇಂದ ${res.metersFromLandmark}m ಅಂತರದಲ್ಲಿ ಕಟ್ ಆಗಿದೆ`;

      const dirLabel = res.direction === 'reverse' ? 'Reverse (End → OLT)' : 'Forward (OLT → End)';
      document.getElementById('faultSubDetails').textContent =
        `${route.name} • ${dirLabel} • Mode: ${res.slackMode === 'optical' ? 'Optical (with Slack)' : 'Ground Distance'}`;

      document.getElementById('faultCoordsText').textContent = `${res.lat}, ${res.lng}`;
      const urlEl = document.getElementById('faultMapsUrl');
      urlEl.href = mapsLink;
      urlEl.textContent = mapsLink;

      document.getElementById('openMapsBtn').href = mapsLink;
      document.getElementById('openStreetViewBtn').href = streetViewLink;
      const svUrlEl = document.getElementById('faultStreetViewUrl');
      svUrlEl.href = streetViewLink;
      svUrlEl.textContent = `🧍‍♂️ 360° Street View: ${streetViewLink}`;

      if (!document.getElementById('streetViewOverlay').classList.contains('hidden')) {
        openInAppStreetView(res);
      }

      const waText = encodeURIComponent(
        `🚨 *OFC Cable Fault Alert*\nRoute: ${route.name}\nOTDR Reading: ${res.clampedMeters}m\nNearest Point: ${res.refLandmark.label} (${res.metersFromLandmark}m away)\nGPS: ${res.lat}, ${res.lng}\n📍 Map Link: ${mapsLink}\n🧍‍♂️ 360° Street View: ${streetViewLink}`
      );
      document.getElementById('whatsappShareBtn').href = `https://wa.me/?text=${waText}`;

      const wpContainer = document.getElementById('waypointList');
      wpContainer.innerHTML = '';
      res.analysis.segments.forEach((seg) => {
        const dVal = res.slackMode === 'optical' ? Math.round(seg.cumOpticalEnd) : Math.round(seg.cumGroundEnd);
        const nodeMapUrl = `https://www.google.com/maps?q=${seg.point.lat},${seg.point.lng}`;
        const row = document.createElement('div');
        row.className = 'flex items-center justify-between bg-slate-950/90 px-4 py-3.5 rounded-2xl border border-slate-800';
        row.innerHTML = `
          <div>
            <div class="text-white font-bold">${seg.point.label}</div>
            <div class="text-xs text-slate-400 font-mono">${seg.point.lat}, ${seg.point.lng}</div>
          </div>
          <div class="text-right">
            <div class="font-mono text-emerald-400 font-black">${dVal}m <span class="text-slate-400 text-xs">(+${seg.point.slack || 0}m loop)</span></div>
            <a href="${nodeMapUrl}" target="_blank" rel="noopener noreferrer" class="text-xs text-cyan-400 underline">Open Map ↗</a>
          </div>
        `;
        wpContainer.appendChild(row);
      });

      drawOtdrTrace(res);
      return res;
    }


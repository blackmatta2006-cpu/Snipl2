<!DOCTYPE html>
<html lang="kn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FiberGrid Pro — Ultra Full-Screen Animated OFC GIS, Auto-Drive & OTDR OS</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+Kannada:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', 'Noto Sans Kannada', sans-serif;
      background-color: #030712;
      color: #f8fafc;
      overflow-x: hidden;
    }
    /* Edge-to-Edge Giant Full-Screen Map (85vh) */
    #map {
      width: 100%;
      height: calc(100vh - 140px);
      min-height: 640px;
      z-index: 10;
      background: #0f172a;
      border-radius: 24px;
    }
    .leaflet-popup-content-wrapper {
      background: #0f172a;
      color: #f8fafc;
      border: 1px solid #334155;
      border-radius: 16px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85);
    }
    .leaflet-popup-tip {
      background: #0f172a;
    }
    /* Dramatic Full-Screen Page Zoom-Slide Animation */
    @keyframes fullScreenZoomIn {
      0% {
        opacity: 0;
        transform: scale(0.88) translateY(45px);
        filter: blur(8px);
      }
      60% {
        opacity: 1;
        filter: blur(0px);
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0px);
      }
    }
    .screen-animate {
      animation: fullScreenZoomIn 0.52s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @keyframes staggerUp {
      0% {
        opacity: 0;
        transform: translateY(24px) scale(0.95);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .stagger-card {
      animation: staggerUp 0.48s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .launcher-card {
      position: relative;
      overflow: hidden;
      transition: all 0.36s cubic-bezier(0.22, 1, 0.36, 1);
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.92), rgba(7, 11, 20, 0.98));
    }
    .launcher-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at top right, rgba(16, 185, 129, 0.14), transparent 60%);
      opacity: 0;
      transition: opacity 0.36s ease;
    }
    .launcher-card:hover {
      transform: translateY(-8px) scale(1.022);
      box-shadow: 0 28px 60px -15px rgba(16, 185, 129, 0.3);
    }
    .launcher-card:hover::before {
      opacity: 1;
    }
    .launcher-card:active {
      transform: scale(0.96);
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.8); opacity: 0.95; }
      70% { transform: scale(2.8); opacity: 0; }
      100% { transform: scale(2.8); opacity: 0; }
    }
    .fault-pulse {
      position: relative;
      width: 26px;
      height: 26px;
      background: #ef4444;
      border: 3px solid #ffffff;
      border-radius: 50%;
      box-shadow: 0 0 20px #ef4444;
    }
    .fault-pulse::after {
      content: '';
      position: absolute;
      top: -6px;
      left: -6px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(239, 68, 68, 0.75);
      animation: pulse-ring 1.5s infinite ease-out;
    }
    .drive-vehicle-marker {
      position: relative;
      width: 34px;
      height: 34px;
      background: #06b6d4;
      border: 3px solid #ffffff;
      border-radius: 50%;
      box-shadow: 0 0 24px #06b6d4;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 17px;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #030712;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 9999px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-[#030712] text-slate-100 select-none sm:select-auto">


      document.getElementById('backToHubBtn').addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
        switchPage('page-hub');
      });

      document.querySelectorAll('[data-launchpage]').forEach((card) => {
        card.addEventListener('click', () => {
          const targetPage = card.getAttribute('data-launchpage');
          switchPage(targetPage);
        });
      });

      // User Card 2: Giant Full-Screen Map
      document.getElementById('userCardGiantMap').addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
        switchPage('page-map');
      });

      // User Card 3: Direct Full-Screen 360° Street View Launch
      document.getElementById('userLaunchStreetViewCard').addEventListener('click', () => {
        openInAppStreetView(lastFaultResult);
      });

      // User Card 6: Direct Full-Screen Satellite Aerial Cut View
      document.getElementById('userCardSatelliteMap').addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
        switchPage('page-map');
        if (map.hasLayer(streetTileLayer)) map.removeLayer(streetTileLayer);
        if (!map.hasLayer(satelliteTileLayer)) satelliteTileLayer.addTo(map);
        showToast('🛰️ Full-Screen Satellite View Activated!');
      });

      // User Card 8: Reverse OTDR & Slack Mode
      document.getElementById('userCardReverseCalc').addEventListener('click', () => {
        document.getElementById('measureDirection').value = 'reverse';
        updateFaultVisualization(currentFaultDistanceMeters, true);
        switchPage('page-otdr');
        showToast('🧭 Reverse OTDR Mode (End → OLT) Activated!');
      });

      // Admin Card 1: Direct Auto-Drive GPS Launch
      document.getElementById('adminLaunchDriveCard').addEventListener('click', () => {
        switchPage('page-map');
        startSimulatedDriving();
      });

      // Admin Card 2: Direct Manual Route Builder Launch
      document.getElementById('adminLaunchManualDrawCard').addEventListener('click', () => {
        switchPage('page-map');
        isDrawingMode = true;
        drawnPoints = [];
        document.getElementById('drawToolbar').classList.remove('hidden');
        showToast('ಮ್ಯಾಪ್ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ ಹೊಸ ಕೇಬಲ್ ರೂಟ್ ಪಾಯಿಂಟ್ಸ್ ಸೇರಿಸಿ!');
      });

      // Admin Card 4: KML Import Studio
      document.getElementById('adminLaunchKmlCard').addEventListener('click', () => {
        document.getElementById('routeDataTextarea').value = JSON.stringify(getActiveRoute(), null, 2);
        document.getElementById('kmlModal').classList.remove('hidden');
      });

      // Admin Card 8: Firebase Cloud Sync Modal
      document.getElementById('adminLaunchFirebaseCard').addEventListener('click', () => {
        document.getElementById('firebaseModal').classList.remove('hidden');
      });

      // Cross-page navigation helpers
      document.getElementById('traceGoToLinksBtn').addEventListener('click', () => {
        switchPage('page-links');
      });
      document.getElementById('traceOpenMapBtn').addEventListener('click', () => {
        switchPage('page-map');
      });
      document.getElementById('traceOpenNodesBtn').addEventListener('click', () => {
        switchPage('page-nodes');
      });
      document.getElementById('nodesToMapBtn').addEventListener('click', () => {
        switchPage('page-map');
      });

      document.querySelectorAll('.nav-tab-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          switchPage(btn.getAttribute('data-navpage'));
        });
      });

      const loginModal = document.getElementById('loginScreenModal');
      document.getElementById('openLoginModalBtn').addEventListener('click', () => {
        loginModal.classList.remove('hidden');
      });
      document.getElementById('closeLoginModalBtn').addEventListener('click', () => {
        loginModal.classList.add('hidden');
      });
      document.getElementById('loginForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const role = document.getElementById('loginRoleSelect').value;
        const uname = document.getElementById('loginUsername').value.trim() || role;
        applyUserRole(role, uname);
      });
      document.querySelectorAll('.quick-role-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const r = btn.getAttribute('data-quickrole');
          applyUserRole(r, `${r} User`);
        });
      });

      document.getElementById('startLiveGpsDriveBtn').addEventListener('click', () => {
        startRealGpsDriving();
      });
      document.getElementById('simulateDriveBtn').addEventListener('click', () => {
        startSimulatedDriving();
      });
      document.getElementById('stopDriveSaveBtn').addEventListener('click', () => {
        finishAndSaveDrivenRoute();
      });

      document.getElementById('dropPoleNowBtn').addEventListener('click', () => {
        const c = drivePoints.length > 0 ? drivePoints[drivePoints.length - 1] : map.getCenter();
        recordDrivenPoint(c.lat + 0.0004, c.lng + 0.0004, 25, 'POLE', `Driven Pole #${drivePoints.length + 1}`, 0);
        showToast('📍 Pole Marked on Driven Route!');
      });
      document.getElementById('dropJcNowBtn').addEventListener('click', () => {
        const c = drivePoints.length > 0 ? drivePoints[drivePoints.length - 1] : map.getCenter();
        recordDrivenPoint(c.lat + 0.0005, c.lng + 0.0005, 20, 'JC', `Driven JC #${drivePoints.length + 1}`, 30);
        showToast('📦 Joint Box (+30m Loop Slack) Marked!');
      });
      document.getElementById('dropChamberNowBtn').addEventListener('click', () => {
        const c = drivePoints.length > 0 ? drivePoints[drivePoints.length - 1] : map.getCenter();
        recordDrivenPoint(c.lat + 0.0005, c.lng + 0.0005, 15, 'JC', `Underground Chamber #${drivePoints.length + 1}`, 40);
        showToast('🕳️ Chamber (+40m Loop Slack) Marked!');
      });

      appendChatMessage(
        'bot',
        `
          <div class="font-bold text-emerald-400">ನಮಸ್ಕಾರ! 👋 OTDR Fault Locator Bot ರೆಡಿ ಇದೆ.</div>
          <div class="text-slate-300">
            ಸ್ಪ್ಲೈಸರ್ ಅಥವಾ ಯೂಸರ್ ಕೇಬಲ್ ಎಷ್ಟು ಮೀಟರ್ ಕಟ್ ಆಗಿದೆ ಅಂತ ಇಲ್ಲಿ ಮೆಸೇಜ್ ಕಳಿಸಿದ ತಕ್ಷಣ (ಉದಾ: <strong>"1450 meter cut agide"</strong> ಅಥವಾ <strong>"2.3 km fault"</strong>), ಆಪ್ ತಾನಾಗಿಯೇ ಲೆಕ್ಕ ಹಾಕಿ ನಿಖರವಾದ <strong>Google Maps & 360° Street View Link</strong> ಕಳಿಸುತ್ತದೆ.
          </div>
        `
      );
      handleUserChatMessage('1450 meter cut agide');

      document.getElementById('chatForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const input = document.getElementById('chatInput');
        const msg = input.value;
        if (!msg.trim()) return;
        input.value = '';
        handleUserChatMessage(msg);
      });

      document.querySelectorAll('.sample-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sampleText = btn.getAttribute('data-sample');
          handleUserChatMessage(sampleText);
        });
      });

      document.getElementById('chatMessages').addEventListener('click', (e) => {
        const copyBtn = e.target.closest('.chat-copy-btn');
        if (copyBtn) {
          const link = copyBtn.getAttribute('data-copylink');
          copyTextToClipboard(link);
          return;
        }
        const svBtn = e.target.closest('.chat-inapp-sv-btn');
        if (svBtn) {
          openInAppStreetView(lastFaultResult);
        }
      });

      document.getElementById('botGoToTraceBtn').addEventListener('click', () => {
        switchPage('page-trace');
      });

      document.getElementById('jumpToMapFromOtdrBtn').addEventListener('click', () => {
        switchPage('page-map');
        if (lastFaultResult) {
          map.setView([lastFaultResult.lat, lastFaultResult.lng], 16, { animate: true });
          if (faultMarker) faultMarker.openPopup();
        }
      });

      const streetBtn = document.getElementById('layerStreetBtn');
      const satBtn = document.getElementById('layerSatBtn');
      streetBtn.addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
        if (map.hasLayer(satelliteTileLayer)) map.removeLayer(satelliteTileLayer);
        if (!map.hasLayer(streetTileLayer)) streetTileLayer.addTo(map);
        streetBtn.className = 'px-3.5 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-extrabold transition';
        satBtn.className = 'px-3.5 py-1.5 rounded-xl text-slate-300 hover:text-white text-xs font-extrabold transition';
      });

      satBtn.addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
        if (map.hasLayer(streetTileLayer)) map.removeLayer(streetTileLayer);
        if (!map.hasLayer(satelliteTileLayer)) satelliteTileLayer.addTo(map);
        satBtn.className = 'px-3.5 py-1.5 rounded-xl bg-emerald-600 text-white text-xs font-extrabold transition';
        streetBtn.className = 'px-3.5 py-1.5 rounded-xl text-slate-300 hover:text-white text-xs font-extrabold transition';
      });

      document.getElementById('openStreetViewPanelBtn').addEventListener('click', () => {
        openInAppStreetView(lastFaultResult);
      });

      document.getElementById('closeStreetViewOverlayBtn').addEventListener('click', () => {
        document.getElementById('streetViewOverlay').classList.add('hidden');
      });

      document.getElementById('svCopyPanoLinkBtn').addEventListener('click', () => {
        const url = document.getElementById('svExternalPanoBtn').href;
        copyTextToClipboard(url);
      });

      document.getElementById('copySvLinkMainBtn').addEventListener('click', () => {
        const url = document.getElementById('openStreetViewBtn').href;
        copyTextToClipboard(url);
      });

      document.getElementById('clearChatBtn').addEventListener('click', () => {
        document.getElementById('chatMessages').innerHTML = '';
        appendChatMessage(
          'bot',
          `<div class="text-slate-300">ಚಾಟ್ ಕ್ಲಿಯರ್ ಆಗಿದೆ. ಹೊಸ OTDR ಮೀಟರ್ ರೀಡಿಂಗ್ ಟೈಪ್ ಮಾಡಿ ಕಳಿಸಿ (ಉದಾ: <strong>950m cut</strong>).</div>`
        );
      });

      document.getElementById('routeSelect').addEventListener('change', (e) => {
        activeRouteId = e.target.value;
        const res = updateFaultVisualization(1000, true);
        appendChatMessage(
          'bot',
          `<div>🔄 ರೂಟ್ ಬದಲಾಗಿದೆ: <strong>${getActiveRoute().name}</strong> (ಒಟ್ಟು ಉದ್ದ: ${res.maxRouteMeters}m). ಈಗ ಎಷ್ಟು ಮೀಟರ್ ಕಟ್ ಆಗಿದೆ ಎಂದು ಕಳಿಸಿ.</div>`
        );
      });

      ['measureDirection', 'slackMode', 'cableSlackPct'].forEach((id) => {
        document.getElementById(id).addEventListener('change', () => {
          updateFaultVisualization(currentFaultDistanceMeters, false);
        });
      });

      document.getElementById('otdrSlider').addEventListener('input', (e) => {
        const dist = parseInt(e.target.value, 10) || 0;
        updateFaultVisualization(dist, false);
      });

      document.getElementById('copyLinkBtn').addEventListener('click', () => {
        const url = document.getElementById('faultMapsUrl').href;
        copyTextToClipboard(url);
      });

      document.getElementById('toggleDrawBtn').addEventListener('click', () => {
        isDrawingMode = !isDrawingMode;
        drawnPoints = [];
        if (drawPreviewLine) map.removeLayer(drawPreviewLine);
        document.getElementById('drawToolbar').classList.toggle('hidden', !isDrawingMode);
      });

      document.getElementById('undoPointBtn').addEventListener('click', () => {
        drawnPoints.pop();
        renderDrawPreview();
      });

      document.getElementById('cancelDrawBtn').addEventListener('click', () => {
        isDrawingMode = false;
        drawnPoints = [];
        if (drawPreviewLine) map.removeLayer(drawPreviewLine);
        document.getElementById('drawToolbar').classList.add('hidden');
      });

      document.getElementById('saveDrawnRouteBtn').addEventListener('click', () => {
        if (drawnPoints.length < 2) {
          showToast('ಕನಿಷ್ಠ 2 ಪಾಯಿಂಟ್ಸ್ ಮ್ಯಾಪ್ ಮೇಲೆ ಕ್ಲಿಕ್ ಮಾಡಿ!');
          return;
        }
        const customName = document.getElementById('newRouteName').value.trim() || `Custom Route ${ROUTES.length + 1}`;
        const newId = `route-${Date.now()}`;
        drawnPoints[drawnPoints.length - 1].type = 'END';
        drawnPoints[drawnPoints.length - 1].label = `${customName} End Node`;

        ROUTES.push({
          id: newId,
          name: customName,
          fiberType: 'Custom OFC Route',
          points: [...drawnPoints]
        });

        activeRouteId = newId;
        isDrawingMode = false;
        drawnPoints = [];
        if (drawPreviewLine) map.removeLayer(drawPreviewLine);
        document.getElementById('drawToolbar').classList.add('hidden');
        populateRouteDropdown();
        updateFaultVisualization(250, true);
        showToast('ಹೊಸ ರೂಟ್ ಸೇವ್ ಆಗಿದೆ!');
        syncRoutesToFirebase(true);
      });

      document.getElementById('routesDirectoryGrid').addEventListener('click', (e) => {
        const mapBtn = e.target.closest('.route-card-map-btn');
        if (mapBtn) {
          activeRouteId = mapBtn.getAttribute('data-selectroute');
          document.getElementById('routeSelect').value = activeRouteId;
          switchPage('page-map');
          updateFaultVisualization(800, true);
          return;
        }
        const otdrBtn = e.target.closest('.route-card-otdr-btn');
        if (otdrBtn) {
          activeRouteId = otdrBtn.getAttribute('data-otdrroute');
          document.getElementById('routeSelect').value = activeRouteId;
          switchPage('page-otdr');
          updateFaultVisualization(1200, false);
        }
      });

      document.getElementById('goToDriveFromRoutesBtn').addEventListener('click', () => {
        switchPage('page-map');
        startSimulatedDriving();
      });

      document.getElementById('addStaffForm').addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('staffNameInput').value.trim();
        const phone = document.getElementById('staffPhoneInput').value.trim();
        const role = document.getElementById('staffRoleInput').value;
        if (!name || !phone) return;
        STAFF_MEMBERS.unshift({
          id: `st-${Date.now()}`,
          name,
          phone,
          role,
          status: 'Active'
        });
        document.getElementById('staffNameInput').value = '';
        document.getElementById('staffPhoneInput').value = '';
        renderAdminDashboard();
        showToast(`${name} (${role}) ಸೇರಿಸಲಾಗಿದೆ!`);
      });

      document.getElementById('adminFaultTicketsList').addEventListener('click', (e) => {
        const btn = e.target.closest('.toggle-tkt-btn');
        if (!btn) return;
        const idx = parseInt(btn.getAttribute('data-tktidx'), 10);
        if (FAULT_TICKETS[idx]) {
          FAULT_TICKETS[idx].status = FAULT_TICKETS[idx].status === 'Resolved' ? 'Open Cut' : 'Resolved';
          renderAdminDashboard();
        }
      });

      document.getElementById('clearResolvedTicketsBtn').addEventListener('click', () => {
        for (let i = FAULT_TICKETS.length - 1; i >= 0; i--) {
          if (FAULT_TICKETS[i].status === 'Resolved') FAULT_TICKETS.splice(i, 1);
        }
        renderAdminDashboard();
        showToast('Resolved tickets cleared!');
      });

      document.getElementById('adminSyncAllBtn').addEventListener('click', () => {
        syncRoutesToFirebase(false);
      });

      const modal = document.getElementById('kmlModal');
      document.getElementById('openKmlModalBtn').addEventListener('click', () => {
        document.getElementById('routeDataTextarea').value = JSON.stringify(getActiveRoute(), null, 2);
        document.getElementById('importFeedback').classList.add('hidden');
        modal.classList.remove('hidden');
      });

      document.getElementById('closeKmlModalBtn').addEventListener('click', () => {
        modal.classList.add('hidden');
      });

      const fbModal = document.getElementById('firebaseModal');
      document.getElementById('openFirebaseModalBtn').addEventListener('click', () => {
        fbModal.classList.remove('hidden');
      });
      document.getElementById('closeFirebaseModalBtn').addEventListener('click', () => {
        fbModal.classList.add('hidden');
      });
      document.getElementById('pushFirebaseBtn').addEventListener('click', () => {
        syncRoutesToFirebase(false);
      });
      document.getElementById('pullFirebaseBtn').addEventListener('click', () => {
        loadRoutesFromFirebase(false);
      });

      loadRoutesFromFirebase(true);

      document.getElementById('exportCurrentRouteBtn').addEventListener('click', () => {
        document.getElementById('routeDataTextarea').value = JSON.stringify(getActiveRoute(), null, 2);
        showToast('Current Route JSON loaded!');
      });

      document.getElementById('importRouteConfirmBtn').addEventListener('click', () => {
        const raw = document.getElementById('routeDataTextarea').value.trim();
        const feedback = document.getElementById('importFeedback');
        try {
          if (raw.includes('<coordinates>')) {
            const match = raw.match(/<coordinates>([\s\S]*?)<\/coordinates>/i);
            if (!match) throw new Error('KML coordinates tag not found');
            const pairs = match[1].trim().split(/\s+/);
            const pts = pairs
              .map((p, idx) => {
                const parts = p.split(',');
                const lng = parseFloat(parts[0]);
                const lat = parseFloat(parts[1]);
                if (isNaN(lat) || isNaN(lng)) return null;
                return {
                  lat,
                  lng,
                  label: idx === 0 ? 'Imported KML OLT' : `KML Point #${idx + 1}`,
                  type: idx === 0 ? 'OLT' : 'JC',
                  slack: 20
                };
              })
              .filter(Boolean);
            if (pts.length < 2) throw new Error('Need at least 2 valid coordinate pairs');
            const kmlRouteId = `route-kml-${Date.now()}`;
            ROUTES.push({
              id: kmlRouteId,
              name: `Imported KML Route (${pts.length} pts)`,
              fiberType: 'Imported KML OFC',
              points: pts
            });
            activeRouteId = kmlRouteId;
          } else {
            const parsedObj = JSON.parse(raw);
            if (!parsedObj.points || parsedObj.points.length < 2) {
              throw new Error('JSON must include a points array with at least 2 lat/lng points');
            }
            const newId = `route-json-${Date.now()}`;
            ROUTES.push({
              id: newId,
              name: parsedObj.name || `Imported Route ${ROUTES.length + 1}`,
              fiberType: parsedObj.fiberType || 'OFC',
              points: parsedObj.points
            });
            activeRouteId = newId;
          }
          populateRouteDropdown();
          updateFaultVisualization(500, true);
          modal.classList.add('hidden');
          showToast('Route Imported Successfully!');
        } catch (err) {
          feedback.textContent = 'Import Error: ' + err.message;
          feedback.classList.remove('hidden');
        }
      });
    });
  </script>
</body>
</html>
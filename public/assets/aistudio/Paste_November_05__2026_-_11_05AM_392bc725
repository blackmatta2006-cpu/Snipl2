    function drawOtdrTrace(faultResult) {
      const canvas = document.getElementById('otdrCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;

      ctx.clearRect(0, 0, W, H);

      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 1;
      for (let x = 50; x < W; x += 90) {
        ctx.beginPath();
        ctx.moveTo(x, 14);
        ctx.lineTo(x, H - 30);
        ctx.stroke();
      }
      for (let y = 24; y < H - 30; y += 38) {
        ctx.beginPath();
        ctx.moveTo(45, y);
        ctx.lineTo(W - 18, y);
        ctx.stroke();
      }

      const maxM = Math.max(faultResult.maxRouteMeters, 500);
      const cutRatio = Math.min(1, faultResult.clampedMeters / maxM);
      const startX = 50;
      const endX = W - 28;
      const cutX = startX + (endX - startX) * cutRatio;

      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 3.5;
      ctx.beginPath();
      ctx.moveTo(startX, 55);
      ctx.lineTo(startX + 8, 22);
      ctx.lineTo(startX + 18, 60);

      const cutY = 60 + cutRatio * 85;
      ctx.lineTo(cutX, cutY);
      ctx.lineTo(cutX + 6, cutY - 42);
      ctx.lineTo(cutX + 14, H - 36);
      ctx.stroke();

      ctx.strokeStyle = '#ef4444';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(cutX + 14, H - 36);
      for (let x = cutX + 20; x < endX; x += 8) {
        const noiseY = H - 36 + (Math.sin(x * 0.7) * 5);
        ctx.lineTo(x, noiseY);
      }
      ctx.stroke();

      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.arc(cutX + 6, cutY - 42, 6.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 14px Inter, sans-serif';
      const labelText = `⚠️ Reflective Fault Cut @ ${faultResult.clampedMeters}m`;
      const textX = Math.min(W - 260, Math.max(54, cutX - 60));
      ctx.fillText(labelText, textX, Math.max(24, cutY - 52));

      ctx.fillStyle = '#94a3b8';
      ctx.font = 'bold 12px monospace';
      ctx.fillText('0m (OLT Start)', 46, H - 8);
      ctx.fillText(`Max: ${faultResult.maxRouteMeters}m`, W - 130, H - 8);
    }

    function drawStreetViewCorridor(res) {
      const canvas = document.getElementById('svCorridorCanvas');
      if (!canvas || !res) return;
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      const skyGrad = ctx.createLinearGradient(0, 0, 0, H * 0.52);
      skyGrad.addColorStop(0, '#0f172a');
      skyGrad.addColorStop(1, '#1e293b');
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, W, H * 0.52);

      ctx.fillStyle = '#090d16';
      ctx.fillRect(0, H * 0.52, W, H * 0.48);

      const vpX = W * 0.5;
      const vpY = H * 0.48;
      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.moveTo(vpX - 24, vpY);
      ctx.lineTo(vpX + 24, vpY);
      ctx.lineTo(W * 0.9, H);
      ctx.lineTo(W * 0.1, H);
      ctx.closePath();
      ctx.fill();

      ctx.strokeStyle = '#475569';
      ctx.setLineDash([7, 7]);
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(vpX, vpY);
      ctx.lineTo(vpX, H);
      ctx.stroke();
      ctx.setLineDash([]);

      const poles = [
        { x: W * 0.22, baseY: H * 0.92, topY: H * 0.18 },
        { x: W * 0.34, baseY: H * 0.72, topY: H * 0.28 },
        { x: W * 0.43, baseY: H * 0.58, topY: H * 0.36 }
      ];
      ctx.strokeStyle = '#94a3b8';
      ctx.lineWidth = 3;
      poles.forEach((p) => {
        ctx.beginPath();
        ctx.moveTo(p.x, p.baseY);
        ctx.lineTo(p.x, p.topY);
        ctx.stroke();
      });

      const cutX = (poles[0].x + poles[1].x) / 2;
      const cutY = (poles[0].topY + poles[1].topY) / 2 + 6;
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(poles[0].x, poles[0].topY + 4);
      ctx.lineTo(cutX, cutY);
      ctx.stroke();

      ctx.strokeStyle = '#ef4444';
      ctx.setLineDash([5, 5]);
      ctx.beginPath();
      ctx.moveTo(cutX, cutY + 4);
      ctx.lineTo(poles[1].x, poles[1].topY + 4);
      ctx.lineTo(poles[2].x, poles[2].topY + 3);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.fillStyle = '#ef4444';
      ctx.beginPath();
      ctx.arc(cutX, cutY, 7, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();

      ctx.fillStyle = '#f8fafc';
      ctx.font = 'bold 12px Inter, sans-serif';
      ctx.fillText(`⚠️ CUT @ ${res.clampedMeters}m`, cutX + 12, cutY + 4);

      ctx.fillStyle = '#38bdf8';
      ctx.font = '11px monospace';
      ctx.fillText(`Cam Heading: ${res.heading}° (${res.compassDir})`, 12, 18);

      ctx.fillStyle = '#fbbf24';
      ctx.font = '11px Inter, sans-serif';
      ctx.fillText(`Nearest: ${res.refLandmark.label} (${res.metersFromLandmark}m)`, 12, H - 10);
    }


    function haversineMeters(lat1, lon1, lat2, lon2) {
      const R = 6371000;
      const toRad = (deg) => (deg * Math.PI) / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) *
        Math.sin(dLon / 2) * Math.sin(dLon / 2);
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function calculateBearing(lat1, lon1, lat2, lon2) {
      const toRad = (d) => (d * Math.PI) / 180;
      const toDeg = (r) => (r * 180) / Math.PI;
      const dLon = toRad(lon2 - lon1);
      const y = Math.sin(dLon) * Math.cos(toRad(lat2));
      const x =
        Math.cos(toRad(lat1)) * Math.sin(toRad(lat2)) -
        Math.sin(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.cos(dLon);
      return Math.round((toDeg(Math.atan2(y, x)) + 360) % 360);
    }

    function bearingToCompass(deg) {
      const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
      return dirs[Math.round(deg / 45) % 8];
    }

    function buildStreetViewUrl(lat, lng, heading = 0) {
      return `https://www.google.com/maps/@?api=1&map_action=pano&viewpoint=${lat},${lng}&heading=${heading}&pitch=0`;
    }

    function getActiveRoute() {
      return ROUTES.find((r) => r.id === activeRouteId) || ROUTES[0];
    }

    function analyzeRoute(route, direction, slackMode, cableSlackPct) {
      const rawPts = direction === 'reverse' ? [...route.points].reverse() : [...route.points];
      const helixMultiplier = slackMode === 'optical' ? (1 + (Number(cableSlackPct) || 0) / 100) : 1;

      const segments = [];
      let totalGroundMeters = 0;
      let totalOpticalMeters = 0;

      for (let i = 0; i < rawPts.length; i++) {
        const pt = rawPts[i];
        const nodeSlack = slackMode === 'optical' ? (Number(pt.slack) || 0) : 0;

        if (i === 0) {
          totalOpticalMeters += nodeSlack;
          segments.push({
            index: 0,
            point: pt,
            segGround: 0,
            segOptical: nodeSlack,
            cumGroundStart: 0,
            cumGroundEnd: 0,
            cumOpticalStart: 0,
            cumOpticalEnd: totalOpticalMeters
          });
        } else {
          const prev = rawPts[i - 1];
          const gDist = haversineMeters(prev.lat, prev.lng, pt.lat, pt.lng);
          const spanOptical = gDist * helixMultiplier;
          const cumGStart = totalGroundMeters;
          const cumOStart = totalOpticalMeters;

          totalGroundMeters += gDist;
          totalOpticalMeters += spanOptical + nodeSlack;

          segments.push({
            index: i,
            fromPoint: prev,
            point: pt,
            segGround: gDist,
            spanOptical: spanOptical,
            nodeSlack: nodeSlack,
            cumGroundStart: cumGStart,
            cumGroundEnd: totalGroundMeters,
            cumOpticalStart: cumOStart,
            cumOpticalEnd: totalOpticalMeters
          });
        }
      }

      return {
        orderedPoints: rawPts,
        segments,
        totalGroundMeters,
        totalOpticalMeters
      };
    }

    function locateFaultAlongRoute(route, targetMeters) {
      const direction = document.getElementById('measureDirection').value;
      const slackMode = document.getElementById('slackMode').value;
      const cableSlackPct = parseFloat(document.getElementById('cableSlackPct').value) || 0;

      const analysis = analyzeRoute(route, direction, slackMode, cableSlackPct);
      const maxRouteDistance = slackMode === 'optical' ? analysis.totalOpticalMeters : analysis.totalGroundMeters;
      const clampedDist = Math.max(0, Math.min(targetMeters, maxRouteDistance));

      let faultLat = analysis.orderedPoints[0].lat;
      let faultLng = analysis.orderedPoints[0].lng;
      let splitSegmentIndex = 0;
      let refLandmark = analysis.orderedPoints[0];
      let metersFromLandmark = 0;
      let insideLoopClosure = false;

      for (let i = 1; i < analysis.segments.length; i++) {
        const seg = analysis.segments[i];
        const startVal = slackMode === 'optical' ? seg.cumOpticalStart : seg.cumGroundStart;
        const endVal = slackMode === 'optical' ? seg.cumOpticalEnd : seg.cumGroundEnd;

        if (clampedDist <= endVal || i === analysis.segments.length - 1) {
          splitSegmentIndex = i;
          const intoSeg = Math.max(0, clampedDist - startVal);
          const spanLen = slackMode === 'optical' ? seg.spanOptical : seg.segGround;

          if (intoSeg >= spanLen && seg.nodeSlack > 0) {
            faultLat = seg.point.lat;
            faultLng = seg.point.lng;
            refLandmark = seg.point;
            metersFromLandmark = 0;
            insideLoopClosure = true;
          } else {
            const ratio = spanLen > 0 ? Math.min(1, intoSeg / spanLen) : 0;
            faultLat = seg.fromPoint.lat + (seg.point.lat - seg.fromPoint.lat) * ratio;
            faultLng = seg.fromPoint.lng + (seg.point.lng - seg.fromPoint.lng) * ratio;

            const distFromPrevGround = seg.segGround * ratio;
            const distToNextGround = seg.segGround * (1 - ratio);
            if (distFromPrevGround <= distToNextGround) {
              refLandmark = seg.fromPoint;
              metersFromLandmark = Math.round(distFromPrevGround);
            } else {
              refLandmark = seg.point;
              metersFromLandmark = Math.round(distToNextGround);
            }
          }
          break;
        }
      }

      const intactLatLngs = [];
      const brokenLatLngs = [];
      for (let i = 0; i <= splitSegmentIndex; i++) {
        if (i < splitSegmentIndex) {
          intactLatLngs.push([analysis.orderedPoints[i].lat, analysis.orderedPoints[i].lng]);
        } else {
          intactLatLngs.push([faultLat, faultLng]);
        }
      }
      brokenLatLngs.push([faultLat, faultLng]);
      for (let i = splitSegmentIndex; i < analysis.orderedPoints.length; i++) {
        brokenLatLngs.push([analysis.orderedPoints[i].lat, analysis.orderedPoints[i].lng]);
      }

      const segForHeading = analysis.segments[Math.max(1, splitSegmentIndex)] || analysis.segments[0];
      const faultHeading = segForHeading && segForHeading.fromPoint
        ? calculateBearing(segForHeading.fromPoint.lat, segForHeading.fromPoint.lng, segForHeading.point.lat, segForHeading.point.lng)
        : 0;

      return {
        requestedMeters: targetMeters,
        heading: faultHeading,
        compassDir: bearingToCompass(faultHeading),
        clampedMeters: Math.round(clampedDist),
        maxRouteMeters: Math.round(maxRouteDistance),
        totalGroundMeters: Math.round(analysis.totalGroundMeters),
        totalOpticalMeters: Math.round(analysis.totalOpticalMeters),
        lat: Number(faultLat.toFixed(6)),
        lng: Number(faultLng.toFixed(6)),
        refLandmark,
        metersFromLandmark,
        insideLoopClosure,
        direction,
        slackMode,
        intactLatLngs,
        brokenLatLngs,
        analysis
      };
    }

    function parseSplicerMessage(text) {
      const clean = text.trim();
      const lower = clean.toLowerCase();

      let detectedRouteId = null;
      if (/route\s*1|r1|ರೂಟ್\s*1|majestic|rajajinagar|yeshwanthpur/i.test(clean)) {
        detectedRouteId = 'route-1';
      } else if (/route\s*2|r2|ರೂಟ್\s*2|indiranagar|domlur|koramangala/i.test(clean)) {
        detectedRouteId = 'route-2';
      } else if (/route\s*3|r3|ರೂಟ್\s*3|peenya|jalahalli|dasarahalli/i.test(clean)) {
        detectedRouteId = 'route-3';
      }

      let detectedDirection = null;
      if (/reverse|ultha|ulta|end\s*inda|from\s*end|ಉಲ್ಟಾ|ಕೊನೆಯಿಂದ/i.test(clean)) {
        detectedDirection = 'reverse';
      } else if (/from\s*olt|olt\s*inda|forward|start/i.test(clean)) {
        detectedDirection = 'forward';
      }

      const strippedForDist = lower.replace(/route\s*\d+|r\d+|ರೂಟ್\s*\d+/g, ' ');
      const kmMatch = strippedForDist.match(/(\d+(?:\.\d+)?)\s*(?:km|kilometer|kilometre|ಕಿ\.?ಮೀ|ಕಿಲೋಮೀಟರ್)/i);
      const mMatch = strippedForDist.match(/(\d+(?:\.\d+)?)\s*(?:m|mtr|mtrs|meter|meters|metre|ಮೀ|ಮೀಟರ್)?/i);

      let distanceMeters = null;
      if (kmMatch) {
        distanceMeters = Math.round(parseFloat(kmMatch[1]) * 1000);
      } else if (mMatch) {
        const val = parseFloat(mMatch[1]);
        if (strippedForDist.includes('.') && val < 20 && !/\b(m|meter|mtr)\b/.test(strippedForDist)) {
          distanceMeters = Math.round(val * 1000);
        } else {
          distanceMeters = Math.round(val);
        }
      }

      return {
        distanceMeters,
        detectedRouteId,
        detectedDirection
      };
    }

    function updateDriveTelemetryUI(speedKmh = 0) {
      document.getElementById('driveOdometerText').textContent = `${Math.round(driveTotalMeters)} m`;
      document.getElementById('driveSpeedText').textContent = `${Math.round(speedKmh)} km/h`;
      document.getElementById('drivePtsCountText').textContent = `${drivePoints.length}`;
    }

    function recordDrivenPoint(lat, lng, speedKmh = 28, forcedType = null, forcedLabel = null, forcedSlack = 0) {
      const minStep = parseInt(document.getElementById('driveStepMeters').value, 10) || 25;

      if (drivePoints.length > 0 && !forcedType) {
        const prev = drivePoints[drivePoints.length - 1];
        const dist = haversineMeters(prev.lat, prev.lng, lat, lng);
        if (dist < minStep) return;
        driveTotalMeters += dist;
      } else if (drivePoints.length > 0 && forcedType) {
        const prev = drivePoints[drivePoints.length - 1];
        driveTotalMeters += haversineMeters(prev.lat, prev.lng, lat, lng);
      }

      const idx = drivePoints.length + 1;
      const ptType = forcedType || (idx === 1 ? 'OLT' : 'POLE');
      const ptLabel = forcedLabel || (idx === 1 ? 'Driven OLT Start' : `GPS Auto-Pt #${idx}`);
      const ptSlack = forcedSlack || (idx === 1 ? 20 : 0);

      const newPt = {
        lat: Number(lat.toFixed(6)),
        lng: Number(lng.toFixed(6)),
        label: ptLabel,
        type: ptType,
        slack: ptSlack
      };
      drivePoints.push(newPt);
      updateDriveTelemetryUI(speedKmh);

      const vehicleIcon = L.divIcon({
        className: '',
        html: '<div class="drive-vehicle-marker">🚗</div>',
        iconSize: [34, 34],
        iconAnchor: [17, 17]
      });

      if (!driveVehicleMarker) {
        driveVehicleMarker = L.marker([newPt.lat, newPt.lng], { icon: vehicleIcon }).addTo(map);
      } else {
        driveVehicleMarker.setLatLng([newPt.lat, newPt.lng]);
      }

      if (drivePolyline) map.removeLayer(drivePolyline);
      drivePolyline = L.polyline(
        drivePoints.map((p) => [p.lat, p.lng]),
        { color: '#06b6d4', weight: 7, opacity: 0.95 }
      ).addTo(map);

      map.panTo([newPt.lat, newPt.lng], { animate: true });
    }

    function startRealGpsDriving() {
      stopAllDrivingStreams();
      isLiveDriving = true;
      drivePoints = [];
      driveTotalMeters = 0;
      updateDriveTelemetryUI(0);

      document.getElementById('driveStatusBadge').textContent = '🟢 LIVE GPS TRACKING';
      document.getElementById('driveStatusBadge').className = 'text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 font-mono';
      document.getElementById('stopDriveSaveBtn').classList.remove('hidden');

      if (!navigator.geolocation) {
        showToast('Browser GPS unavailable — starting Simulated Drive instead!');
        startSimulatedDriving();
        return;
      }

      showToast('Live GPS Drive Active! ನೀವು ಚಲಿಸಿದಂತೆ ಮ್ಯಾಪ್ ಡ್ರಾ ಆಗುತ್ತದೆ.');
      gpsWatchId = navigator.geolocation.watchPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          const speedKmh = pos.coords.speed ? pos.coords.speed * 3.6 : 24;
          recordDrivenPoint(lat, lng, speedKmh);
        },
        () => {
          showToast('GPS signal blocked inside sandbox — running Live Road Drive Simulation!');
          startSimulatedDriving();
        },
        { enableHighAccuracy: true, maximumAge: 1000, timeout: 6000 }
      );
    }

    function startSimulatedDriving() {
      stopAllDrivingStreams();
      isLiveDriving = true;
      drivePoints = [];
      driveTotalMeters = 0;

      document.getElementById('driveStatusBadge').textContent = '🚙 AUTO-DRIVE ACTIVE';
      document.getElementById('driveStatusBadge').className = 'text-xs px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-mono';
      document.getElementById('stopDriveSaveBtn').classList.remove('hidden');

      const simPath = [
        [12.9756, 77.6066],
        [12.9772, 77.6031],
        [12.9791, 77.5993],
        [12.9818, 77.5956],
        [12.9852, 77.5924],
        [12.9891, 77.5895],
        [12.9935, 77.5876],
        [12.9982, 77.5858],
        [13.0031, 77.5842],
        [13.0085, 77.5829]
      ];
      let stepIndex = 0;
      map.setView(simPath[0], 15);
      showToast('Auto-Drive Started! ವಾಹನ ಚಲಿಸಿದಂತೆ ಕೇಬಲ್ ರೂಟ್ ಆಟೋ-ಡ್ರಾ ಆಗುತ್ತಿದೆ...');

      driveSimInterval = setInterval(() => {
        if (stepIndex >= simPath.length) {
          clearInterval(driveSimInterval);
          driveSimInterval = null;
          showToast('Drive destination reached! Click "Finish & Save Driven Route".');
          return;
        }
        const [lat, lng] = simPath[stepIndex];
        const isJc = stepIndex === 4 || stepIndex === 7;
        recordDrivenPoint(
          lat,
          lng,
          34 + (stepIndex % 3) * 4,
          stepIndex === 0 ? 'OLT' : isJc ? 'JC' : 'POLE',
          stepIndex === 0
            ? 'MG Road OLT (Driven Start)'
            : isJc
            ? `Auto-Detected JC #0${stepIndex} (+30m Loop)`
            : `Driven Pole #${stepIndex + 1}`,
          stepIndex === 0 ? 20 : isJc ? 30 : 0
        );
        stepIndex++;
      }, 1000);
    }

    function stopAllDrivingStreams() {
      if (gpsWatchId !== null && navigator.geolocation) {
        navigator.geolocation.clearWatch(gpsWatchId);
        gpsWatchId = null;
      }
      if (driveSimInterval) {
        clearInterval(driveSimInterval);
        driveSimInterval = null;
      }
      isLiveDriving = false;
    }

